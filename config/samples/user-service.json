{
  "openapi": "3.0.1",
  "info": { "title": "User Service", "version": "1.0.0" },
  "paths": {
    "/users": {
      "get": {
        "tags": ["Users"],
        "operationId": "ListUsers",
        "summary": "Список пользователей",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "operationId": "GetUser",
        "summary": "Пользователь по id",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
