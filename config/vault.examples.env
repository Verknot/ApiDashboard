# Example Vault KV payloads for API Workbench (KV v2 mount "secret").
# Do not commit real values.

# Postgres connection string (read by Vault:ConnectionStringPath)
# vault kv put secret/pult/db connectionString='Host=pg;Port=5432;Database=api_workbench;Username=workbench;Password=***'

# Client PFX as Base64 (read by auth.cert_vault)
# PowerShell:
#   $b64 = [Convert]::ToBase64String([IO.File]::ReadAllBytes('client.pfx'))
#   vault kv put secret/pult/client-cert certificate=$b64 password='pfx-password'
#
# Or with explicit key in YAML: cert_vault: secret/pult/client-cert#certificate

# Swagger Basic (separate secrets or one path)
# vault kv put secret/swagger/order-service-login value='swagger-user'
# vault kv put secret/swagger/order-service-password value='swagger-pass'
# vault kv put secret/swagger/user-service SwaggerBasicAuthUsername='u' SwaggerBasicAuthPassword='p'
