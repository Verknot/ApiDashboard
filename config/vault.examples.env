# Existing company Vault — do NOT start compose Vault on the environment.
# App needs only Address + Token (or inject Token via orchestrator secret).

# --- Secrets layout (KV v2 mount "secret") ---
#
# vault kv put secret/pult/db \
#   connectionString='Host=pg;Port=5432;Database=api_workbench;Username=workbench;Password=***'
#
# vault kv put secret/pult/app \
#   jwtKey='at-least-32-chars-random-secret-here' \
#   adminPassword='strong-temp-admin-password'
#
# Client PFX (Base64) for api_auth / auth.cert_vault:
#   $b64 = [Convert]::ToBase64String([IO.File]::ReadAllBytes('client.pfx'))
#   vault kv put secret/pult/client-cert certificate=$b64 password='pfx-password'
#
# Swagger Basic:
#   vault kv put secret/swagger/order-service SwaggerBasicAuthUsername='u' SwaggerBasicAuthPassword='p'

# --- Deploy env (API container / k8s) ---
# Leave ConnectionStrings__Default, Jwt__Key, Seed__AdminPassword empty so app reads Vault.

ASPNETCORE_ENVIRONMENT=Production
Vault__Address=https://vault.company.com
Vault__Token=
Vault__ConnectionStringPath=secret/pult/db#connectionString
Vault__JwtKeyPath=secret/pult/app#jwtKey
Vault__SeedAdminPasswordPath=secret/pult/app#adminPassword

# Optional overrides (win over Vault if set):
# ConnectionStrings__Default=
# Jwt__Key=
# Seed__AdminPassword=
