# Copy to .env (gitignored) or set the same keys in K8s / Azure DevOps.
# ASP.NET maps __ to configuration sections.

# --- required in cluster ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Prefer empty ConnectionStrings__Default and load DB from Vault:
ConnectionStrings__Default=
Vault__Address=https://vault.company.com
Vault__Token=
Vault__ConnectionStringPath=secret/pult/db#connectionString

# Or inject connection string from Azure Key Vault / K8s Secret instead of Vault path:
# ConnectionStrings__Default=Host=pg;Port=5432;Database=api_workbench;Username=...;Password=...

Jwt__Key=
Jwt__Issuer=ApiWorkbench
Jwt__Audience=ApiWorkbench

Cors__Origins__0=https://pult.company.com

Seed__AdminEmail=admin@company.com
Seed__AdminPassword=

ServicesConfigPath=/app/config/services.yaml

# --- local docker-compose style (dev Vault) ---
# Vault__Address=http://vault:8200
# Vault__Token=root
# ConnectionStrings__Default=Host=postgres;Port=5432;Database=api_workbench;Username=workbench;Password=workbench
